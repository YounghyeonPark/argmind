#!/bin/sh
# Argmind pre-commit hook.
#
# Runs the test suite. It encodes historical modelling errors as regression tests, the
# "the model must be able to fail" invariants, and the rules this project keeps by looking
# at itself: the licence record, the core naming no platform, one place performing, and a
# voice seam that cannot reach an action. A commit that breaks them is a commit that has
# quietly re-introduced something somebody already paid for once.
#
# **This ran `python -m pytest` until 2026-09-15.** The Python implementation is gone —
# `git show python-before-removal-2026-09-15` — and everything it held is either ported or
# committed as data under `native/expectations/`, `native/golden/` and `measure/`.
#
# Install (once per clone):   git config core.hooksPath .githooks
# Bypass (rarely justified):  git commit --no-verify

set -e

log=$(mktemp 2>/dev/null || echo /tmp/argmind-cargo-test.log)

echo "pre-commit: running test suite..."
if ! cargo test --manifest-path native/Cargo.toml --quiet >"$log" 2>&1; then
    echo ""
    echo "COMMIT BLOCKED: tests failed."
    echo ""
    tail -30 "$log"
    echo ""
    echo "The suite pins relationships, not numbers, so a failure usually means"
    echo "either a real regression or that a settled finding has genuinely changed."
    echo "If it is the latter, update the test DELIBERATELY and say so in the"
    echo "commit message -- do not weaken it to get green."
    exit 1
fi
echo "pre-commit: tests pass."

# --- and the application still builds without an environment -------------------
#
# `--features headless` makes `platform.rs` pick `argmind-env-none`, which is what a macOS
# or Linux checkout would get. It is the only thing standing between "the application is
# portable" and a sentence in a document: a `use argmind_env_windows::` added to `app.rs`
# compiles perfectly well on this machine and quietly un-ports the program.
#
# A rule test catches the ones it can see by reading the source. This catches the rest,
# because the compiler is the only thing that knows what really got linked.

echo "pre-commit: building without an environment..."
nowhere="-p argmind-serve --features headless"
if ! cargo test --manifest-path native/Cargo.toml $nowhere --quiet >"$log" 2>&1; then
    echo ""
    echo "COMMIT BLOCKED: the application no longer builds without an environment."
    echo ""
    tail -30 "$log"
    echo ""
    echo "Something outside platform.rs now needs Windows. Say platform::Sight and"
    echo "let that one file choose -- see native/argmind-serve/src/platform.rs."
    exit 1
fi
echo "pre-commit: it builds and runs with no environment at all."

# --- and it compiles for an operating system that is not this one --------------
#
# Stronger than the headless build, which still has `cfg(windows)` true underneath: this
# takes the other branch of every `cfg` in the tree, including the manifest's
# `[target.'cfg(windows)'.dependencies]`. The window is left out because on Linux it pulls
# `libdbus-sys` and `webkit2gtk-sys`, whose build scripts want a sysroot this machine has
# no reason to have -- `docs/findings/the-window.md` records exactly which packages.
#
# **Skipped loudly rather than quietly** where the target is not installed. A check that
# silently does nothing on most clones is a check that reads green for years.

if rustup target list --installed 2>/dev/null | grep -q '^x86_64-unknown-linux-gnu$'; then
    echo "pre-commit: compiling for linux..."
    linux="--target x86_64-unknown-linux-gnu -p argmind-serve --no-default-features"
    if ! cargo check --manifest-path native/Cargo.toml $linux --quiet >"$log" 2>&1; then
        echo ""
        echo "COMMIT BLOCKED: the application no longer compiles for linux."
        echo ""
        tail -30 "$log"
        exit 1
    fi
    echo "pre-commit: it compiles for linux."
else
    echo "pre-commit: SKIPPED the linux check -- rustup target add x86_64-unknown-linux-gnu"
fi

# --- the front end is compiled and committed -----------------------------------
#
# Everything under `ui/dist/` is `include_str!`d into the server, so a change to the
# TypeScript that is not compiled ships the old page while the diff shows the new one.
# That is the same shape as the perf_model check this replaced: code moving without its
# output moving means the tree now disagrees with itself.
#
# The orb also has a test that runs against the compiled file rather than the source, so a
# stale build fails there as well:  node ui/src/orb.test.mjs

staged=$(git diff --cached --name-only)
ts_changed=$(echo "$staged" | grep -E '^ui/src/.*\.ts$' || true)
js_changed=$(echo "$staged" | grep -E '^ui/dist/.*\.js$' || true)

if [ -n "$ts_changed" ] && [ -z "$js_changed" ]; then
    echo ""
    echo "pre-commit WARNING: ui/src is staged but nothing under ui/dist is."
    echo "Changed:"
    echo "$ts_changed" | sed 's/^/    /'
    echo ""
    echo "The server embeds the compiled file, so build and stage it:"
    echo "    cd ui && npx tsc"
    echo ""
    echo "If the change genuinely produces no different output, proceed --"
    echo "this is a warning, not a block."
fi

exit 0
